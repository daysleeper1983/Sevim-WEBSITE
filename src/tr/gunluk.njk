---
layout: base.njk
locale: tr
page_key: journal
lang_alt_tr: /tr/gunluk/
lang_alt_en: /en/journal/
title: Günlük
---
<section class="section-tight">
  <div class="container">
    <p class="eyebrow">{{ i18n.tr.nav_journal }}</p>
    <h1>{{ i18n.tr.nav_journal }}</h1>
    <p class="lede">{{ site.tr.journal_intro }}</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container grid grid-3">
    {% for post in collections.journal | sortByDateDesc %}
    <a class="card" href="{{ slugs.journal.tr }}{{ post.fileSlug }}/" style="color:inherit;">
      <div class="card-media"><img src="{{ post.data.cover_image }}" alt=""></div>
      <div class="card-body">
        <span class="card-meta">{{ post.data.date | localeDate("tr") }}</span>
        <h3>{{ post.data.tr.title }}</h3>
        <p>{{ post.data.tr.excerpt }}</p>
      </div>
    </a>
    {% else %}
    <p>{{ i18n.tr.no_posts_yet }}</p>
    {% endfor %}
  </div>
</section>
